// YuKon3t data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (NextAuth v5 / Prisma adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Core domain ----------

enum UserStatus {
  ACTIVE
  DEACTIVATED
  SUSPENDED
  BANNED
  DELETED
}

enum PostsVisibility {
  PUBLIC
  CONNECTIONS_ONLY
}

enum TrustBand {
  NEW
  ESTABLISHED
  TRUSTED
}

enum IntentTag {
  FRIENDSHIP
  CULTURAL_EXCHANGE
  PROFESSIONAL
  COMMUNITY
  TRAVEL_TIPS
}

// Synthesized client-side via Web Audio (src/lib/ringtones.ts), not audio
// files — one preference covers both audio and video calls, same as a
// phone's ringtone applying regardless of call type.
enum Ringtone {
  CLASSIC
  CHIME
  DIGITAL
  MARIMBA
  PULSE
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?
  username      String?     @unique
  passwordHash  String?
  birthDate     DateTime?
  name          String?
  avatarUrl     String?
  bio           String?     @db.Text
  country       String?
  languages     String[]    @default([])
  interests     String[]    @default([])
  openToIntents IntentTag[] @default([])

  trustScore Int       @default(0)
  trustBand  TrustBand @default(NEW)

  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveAt  DateTime?

  status           UserStatus @default(ACTIVE)
  suspensionReason String?
  deactivatedAt    DateTime?
  isAdmin          Boolean    @default(false)

  // Set whenever an active session should be forced to re-authenticate
  // (e.g. password reset) even though the JWT itself hasn't expired yet.
  sessionInvalidatedAt DateTime?

  // Password-login brute-force lockout: 4 wrong passwords locks the account
  // for 24h. failedLoginAttempts resets to 0 the moment lockedUntil is set,
  // so it only ever counts attempts within the current (unlocked) window.
  // Completing a real password reset also clears both, since that's proof
  // of email ownership and should unlock the account immediately rather
  // than making a legitimate owner wait out the 24h.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  postsVisibility PostsVisibility @default(PUBLIC)
  discoverable    Boolean         @default(true)
  ringtone        Ringtone        @default(CLASSIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  circleMemberships   CircleMembership[]
  ownedCircles        Circle[]                 @relation("CircleOwner")
  posts               Post[]
  collabPosts         CollabBoardPost[]
  voiceParticipations CircleVoiceParticipant[]

  sentConnections     Connection[] @relation("ConnectionRequester")
  receivedConnections Connection[] @relation("ConnectionTarget")

  sentMessages         Message[]            @relation("MessageSender")
  conversations        ConversationMember[]
  messageReactions     MessageReaction[]
  messageCorrections   MessageCorrection[]
  createdConversations Conversation[]       @relation("ConversationCreator")
  groupJoinRequests    GroupJoinRequest[]

  reportsFiled    Report[] @relation("ReportsFiled")
  reportsReceived Report[] @relation("ReportsReceived")

  auditLogEntries AuditLog[] @relation("AuditLogTarget")

  likes            Like[]
  comments         Comment[]
  commentReactions CommentReaction[]
  shares           Share[]
  postRsvps        PostRsvp[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")

  passwordResetTokens PasswordResetToken[]

  callsMade     Call[] @relation("CallCaller")
  callsReceived Call[] @relation("CallCallee")

  blocksMade        Block[]            @relation("Blocker")
  blocksReceived    Block[]            @relation("Blocked")
  pushSubscriptions PushSubscription[]
  fcmTokens         FcmToken[]
  analyticsEvents   AnalyticsEvent[]

  @@index([country])
  // Matches the discover page's actual query shape (status + discoverable
  // equality filters, ordered by trustScore) — without this, that query
  // forces a full scan + sort as the user table grows.
  @@index([status, discoverable, trustScore])
}

model Circle {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String   @db.Text
  category      String
  coverImageUrl String?
  createdById   String
  createdAt     DateTime @default(now())

  voiceRoomName String?
  voiceRoomUrl  String?

  createdBy         User                     @relation("CircleOwner", fields: [createdById], references: [id], onDelete: Cascade)
  members           CircleMembership[]
  posts             Post[]
  voiceParticipants CircleVoiceParticipant[]
  notifications     Notification[]

  @@index([category])
}

/**
 * Presence, not history — a row exists only while that member is currently in the Circle's persistent voice room.
 */
model CircleVoiceParticipant {
  id       String   @id @default(cuid())
  circleId String
  userId   String
  joinedAt DateTime @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([circleId])
}

enum CircleRole {
  MEMBER
  MODERATOR
  OWNER
}

model CircleMembership {
  id       String     @id @default(cuid())
  userId   String
  circleId String
  role     CircleRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId])
  // The unique constraint above is userId-leading, so it doesn't serve
  // circleId-first lookups — matches how joinCircle filters co-admins by
  // circleId+role on every join, and how /circles now includes a
  // per-viewer membership per Circle card.
  @@index([circleId, role])
}

enum ModerationStatus {
  PUBLISHED
  FLAGGED
  REMOVED
}

enum PostMediaType {
  NONE
  IMAGE
  VIDEO
  EMBED
}

enum EmbedProvider {
  YOUTUBE
  VIMEO
}

model Post {
  id                String           @id @default(cuid())
  authorId          String
  circleId          String?
  content           String           @db.Text
  mediaType         PostMediaType    @default(NONE)
  mediaUrls         String[]         @default([])
  videoUrl          String?
  videoThumbnailUrl String?
  // EMBED posts store only a provider + the extracted video id, never the
  // raw pasted URL — the iframe src is always rebuilt server-side from these
  // two known-safe values, so nothing attacker-controlled ever becomes an
  // iframe src.
  embedProvider     EmbedProvider?
  embedId           String?
  intentTag         IntentTag?
  moderationStatus  ModerationStatus @default(PUBLISHED)
  eventAt           DateTime?
  eventLocation     String?
  // Set once a "starts soon" reminder has gone out (see the event-reminders
  // cron route) so the same event never notifies attendees twice.
  eventReminderSentAt DateTime?
  createdAt         DateTime         @default(now())

  repostOfId String?

  likeCount    Int @default(0)
  commentCount Int @default(0)
  repostCount  Int @default(0)
  shareCount   Int @default(0)
  rsvpCount    Int @default(0)

  author   User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  circle   Circle? @relation(fields: [circleId], references: [id], onDelete: Cascade)
  repostOf Post?   @relation("PostRepost", fields: [repostOfId], references: [id], onDelete: Cascade)
  reposts  Post[]  @relation("PostRepost")

  likes         Like[]
  comments      Comment[]
  shares        Share[]
  rsvps         PostRsvp[]
  notifications Notification[]

  @@unique([authorId, repostOfId])
  @@index([circleId])
  @@index([authorId])
  @@index([repostOfId])
  // Match the home feed's actual query shape (each OR branch filtered by
  // moderationStatus, the whole result ordered by createdAt) — without
  // these, that OR+sort increasingly needs to sort a large intermediate
  // row set as a user's circle/connection graph grows.
  @@index([circleId, moderationStatus, createdAt])
  @@index([authorId, moderationStatus, createdAt])
  // Backs the event-reminders cron's recurring range scan (eventAt between
  // now and the reminder window, reminder not yet sent).
  @@index([eventAt])
}

model Comment {
  id               String           @id @default(cuid())
  postId           String
  authorId         String
  parentId         String?
  content          String           @db.Text
  moderationStatus ModerationStatus @default(PUBLISHED)
  createdAt        DateTime         @default(now())

  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)

  replies       Comment[]         @relation("CommentReplies")
  notifications Notification[]
  reactions     CommentReaction[]

  @@index([postId, createdAt])
  @@index([parentId])
}

/**
 * One active emoji reaction per user per comment — same shape as
 * MessageReaction (picking a new emoji replaces it, re-picking the same one
 * removes it).
 */
model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

/**
 * Presence of a row = "going", same one-per-user-per-post shape as Like — no separate status enum.
 */
model PostRsvp {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Share {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  POST_LIKE
  POST_COMMENT
  POST_REPOST
  POST_SHARE
  EVENT_RSVP
  // Sent to a Circle's creator and any co-admins when a new member joins.
  CIRCLE_JOINED
  // Sent to every site admin (isAdmin=true) when any user creates a new Circle.
  CIRCLE_CREATED
  // Sent to an event post's author and RSVP'd attendees shortly before eventAt.
  EVENT_REMINDER
}

model Notification {
  id           String           @id @default(cuid())
  recipientId  String
  actorId      String
  type         NotificationType
  postId       String?
  commentId    String?
  connectionId String?
  circleId     String?
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  recipient  User        @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor      User        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post       Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    Comment?    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  connection Connection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  circle     Circle?     @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

enum CollabType {
  SKILL_EXCHANGE
  VOLUNTEER
  STUDY_GROUP
  PROJECT
}

enum CollabStatus {
  OPEN
  CLOSED
}

model CollabBoardPost {
  id          String       @id @default(cuid())
  authorId    String
  title       String
  description String       @db.Text
  type        CollabType
  // Mutually exclusive with `countries`: worldwide posts ignore it entirely
  // (kept empty) rather than requiring every country to be enumerated.
  worldwide   Boolean      @default(false)
  countries   String[]     @default([])
  status      CollabStatus @default(OPEN)
  createdAt   DateTime     @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([status])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  targetId    String
  intentTag   IntentTag
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("ConnectionTarget", fields: [targetId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@unique([requesterId, targetId])
  @@index([targetId])
}

model Conversation {
  id           String   @id @default(cuid())
  isGroup      Boolean  @default(false)
  name         String?
  discoverable Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())

  createdBy    User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members      ConversationMember[]
  messages     Message[]
  joinRequests GroupJoinRequest[]
}

model GroupJoinRequest {
  id             String            @id @default(cuid())
  conversationId String
  userId         String
  status         JoinRequestStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  respondedAt    DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId, status])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model ConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

enum MessageMediaType {
  NONE
  AUDIO
  VIDEO
  IMAGE
}

model Message {
  id                   String           @id @default(cuid())
  conversationId       String
  senderId             String
  content              String           @db.Text
  mediaType            MessageMediaType @default(NONE)
  mediaUrl             String?
  mediaThumbnailUrl    String?
  moderationStatus     ModerationStatus @default(PUBLISHED)
  deliveredAt          DateTime?
  readAt               DateTime?
  deletedForEveryoneAt DateTime?
  deletedForUserIds    String[]         @default([])
  editedAt             DateTime?
  createdAt            DateTime         @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[]
  corrections  MessageCorrection[]

  @@index([conversationId])
}

/**
 * One active correction suggestion per (message, corrector) — resubmitting updates it rather than stacking duplicates.
 */
model MessageCorrection {
  id            String   @id @default(cuid())
  messageId     String
  authorId      String
  correctedText String   @db.Text
  createdAt     DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([messageId, authorId])
  @@index([messageId])
}

/**
 * One active emoji reaction per user per message — picking a new emoji replaces it, re-picking the same one removes it.
 */
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

enum ReportTargetType {
  USER
  POST
  MESSAGE
  CIRCLE
  COLLAB_POST
  COMMENT
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportReasonCategory {
  SPAM
  SCAM_OR_FRAUD
  PHISHING
  HARASSMENT
  FAKE_ACCOUNT
  INAPPROPRIATE_CONTENT
  OTHER
}

model Report {
  id             String               @id @default(cuid())
  reporterId     String
  reportedUserId String?
  targetType     ReportTargetType
  targetId       String
  reasonCategory ReportReasonCategory @default(OTHER)
  reason         String               @db.Text
  status         ReportStatus         @default(OPEN)
  resolutionNote String?              @db.Text
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?

  reporter     User  @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum AuditAction {
  WARN
  SUSPEND
  BAN
  REINSTATE
  REPORT_DISMISSED
  REPORT_RESOLVED
  ACCOUNT_DELETED
  CONTENT_REMOVED
  PASSWORD_RESET_SENT
}

model AuditLog {
  id          String      @id @default(cuid())
  targetId    String
  action      AuditAction
  reason      String      @db.Text
  performedBy String
  createdAt   DateTime    @default(now())

  target User @relation("AuditLogTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACCEPTED
  DECLINED
  ENDED
  MISSED
}

model Call {
  id          String     @id @default(cuid())
  callerId    String
  calleeId    String
  type        CallType
  status      CallStatus @default(RINGING)
  roomName    String
  roomUrl     String
  createdAt   DateTime   @default(now())
  respondedAt DateTime?
  endedAt     DateTime?

  caller User @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee User @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([calleeId, status])
  @@index([callerId, status])
}

/**
 * One-directional; "blocked either way" checks look at both directions. Blocking severs any existing connection between the two (see blockUser).
 */
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/**
 * One row per subscribed browser/device (Web Push), not per user — a user can have several.
 */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * One row per registered Android device (Firebase Cloud Messaging) — separate
 * from PushSubscription (Web Push/VAPID) because the shape is different (a
 * single opaque token vs. an endpoint + keypair) and because native call
 * notifications go through FCM's data-message path, not the browser
 * Notification API, so the two need to be sent independently. See
 * src/lib/fcm.ts.
 */
model FcmToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AnalyticsEventType {
  SIGN_UP
  SIGN_IN
  POST_CREATED
  CONNECTION_REQUESTED
  CONNECTION_ACCEPTED
  MESSAGE_SENT
  CALL_STARTED
  CIRCLE_JOINED
  CIRCLE_CREATED
}

/**
 * Lightweight first-party product-usage log — not a PII/session tracker. userId is nullable and SetNull on delete so a deleted account doesn't need to touch this table.
 */
model AnalyticsEvent {
  id        String             @id @default(cuid())
  userId    String?
  type      AnalyticsEventType
  metadata  Json?
  createdAt DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId])
}
