// YuKon3t data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (NextAuth v5 / Prisma adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Core domain ----------

enum UserStatus {
  ACTIVE
  DEACTIVATED
  SUSPENDED
  BANNED
  DELETED
}

enum PostsVisibility {
  PUBLIC
  CONNECTIONS_ONLY
  // Admin-only tier: posts stay invisible to everyone but the author,
  // regardless of connection/circle membership. See src/lib/post-visibility.ts.
  HIDDEN
}

// Section a post is filed under on the Home feed (src/app/home/page.tsx).
// GENERAL is the default for posts that don't fit a specific section.
enum FeedCategory {
  OCCUPATIONAL
  ENTERTAINMENT
  POLITICS
  SPORTS
  EDUCATIONAL
  NEWS
  RELIGIOUS_SPIRITUAL
  FINANCIAL_TIPS
  HEALTH_WELLNESS
  MOTIVATIONAL
  GENERAL
}

enum TrustBand {
  NEW
  ESTABLISHED
  TRUSTED
}

enum IntentTag {
  FRIENDSHIP
  CULTURAL_EXCHANGE
  PROFESSIONAL
  COMMUNITY
  TRAVEL_TIPS
}

// Synthesized client-side via Web Audio (src/lib/ringtones.ts), not audio
// files — one preference covers both audio and video calls, same as a
// phone's ringtone applying regardless of call type.
enum Ringtone {
  CLASSIC
  CHIME
  DIGITAL
  MARIMBA
  PULSE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  username      String?   @unique
  passwordHash  String?
  birthDate     DateTime?

  // Only written at successful OTP confirmation (src/app/actions/phone-
  // verification.ts), never at request time — an abandoned/unconfirmed
  // attempt never touches this column, so @unique can't be violated by a
  // half-finished verification flow. Twilio Verify owns the OTP code's
  // entire lifecycle; no code is ever generated or stored here.
  phone           String?     @unique
  phoneVerifiedAt DateTime?
  name            String?
  avatarUrl       String?
  bio             String?     @db.Text
  country         String?
  languages       String[]    @default([])
  interests       String[]    @default([])
  // Lowercased mirror of `interests`, kept in sync at write time (see
  // completeOnboarding/updateProfile in actions/profile.ts). Prisma's `has`
  // filter on a String[] is case-sensitive with no case-insensitive variant,
  // so exact search (search/page.tsx) matches against this instead of
  // `interests` directly — otherwise a query like "travel" would miss a
  // stored interest of "Travel".
  interestsLower  String[]    @default([])
  openToIntents   IntentTag[] @default([])

  // Embedding of name+username+bio+interests, used by smart/semantic search
  // (src/lib/search-embeddings.ts) as a fallback when exact substring search
  // returns few results. Unsupported because Prisma Client has no native
  // vector type — always read/written via $queryRaw/$executeRaw, never
  // through the typed API. Nullable: absent until the next write or backfill
  // run populates it (see scripts/backfill-embeddings.ts).
  embedding Unsupported("vector(1536)")?

  trustScore Int       @default(0)
  trustBand  TrustBand @default(NEW)

  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveAt  DateTime?

  // Updated every ~45s by a client-side heartbeat while the app is open and
  // visible (src/components/presence-heartbeat.tsx) — deliberately separate
  // from lastActiveAt, which only ticks once per calendar day and only from
  // real content-creation actions for streak/trust purposes. "Online now"
  // (src/lib/presence.ts) is derived from this column instead.
  lastSeenAt DateTime?

  status           UserStatus @default(ACTIVE)
  suspensionReason String?
  deactivatedAt    DateTime?
  isAdmin          Boolean    @default(false)

  // Set whenever an active session should be forced to re-authenticate
  // (e.g. password reset) even though the JWT itself hasn't expired yet.
  sessionInvalidatedAt DateTime?

  // Password-login brute-force lockout: 4 wrong passwords locks the account
  // for 24h. failedLoginAttempts resets to 0 the moment lockedUntil is set,
  // so it only ever counts attempts within the current (unlocked) window.
  // Completing a real password reset also clears both, since that's proof
  // of email ownership and should unlock the account immediately rather
  // than making a legitimate owner wait out the 24h.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Set alongside the first failed attempt in a fresh window, cleared
  // wherever failedLoginAttempts itself resets — gives the resolve-login-
  // issues cron (src/app/api/cron/resolve-login-issues) a precise anchor for
  // "unresolved for 48h", since lockedUntil is a future expiry rather than a
  // start time and updatedAt is bumped by unrelated profile writes too.
  failedLoginAt       DateTime?

  // Set when a genuine login-issue resolution happens — a completed password
  // reset that cleared a lockout/failed-attempt streak, a successful login
  // that did the same, or a confirmation-email click that unstuck a
  // long-unverified account (see resetPassword, loginWithPassword, and
  // confirmEmailVerification in actions/password-auth.ts). Admin/moderation
  // (src/app/admin/moderation/page.tsx) uses this to show the account under
  // "recently resolved" for a day, then drop it from the queue entirely —
  // distinct from the AuditLog PASSWORD_RESET_SENT/VERIFICATION_EMAIL_SENT
  // entries, which record an admin sending help, not the problem actually
  // going away.
  loginIssueResolvedAt DateTime?

  postsVisibility PostsVisibility @default(PUBLIC)
  discoverable    Boolean         @default(true)
  ringtone        Ringtone        @default(CLASSIC)

  // Cheap "what's new" seen-tracking — compared against the latest
  // Announcement.createdAt rather than fanning out a Notification row to
  // every user for something as rare and global as a product announcement.
  lastSeenAnnouncementAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  circleMemberships           CircleMembership[]
  ownedCircles                Circle[]                   @relation("CircleOwner")
  circleJoinRequests          CircleJoinRequest[]
  posts                       Post[]
  collabPosts                 CollabBoardPost[]
  channelsCreated             Channel[]
  channelMemberships          ChannelMembership[]
  channelVoiceParticipations  ChannelVoiceParticipant[]
  collabParticipations        CollabParticipant[]
  collabSessionParticipations CollabSessionParticipant[]
  collabJoinRequests          CollabJoinRequest[]
  sentCollabInvites           CollabInvite[]             @relation("CollabInviter")
  receivedCollabInvites       CollabInvite[]             @relation("CollabInvitee")
  sentVoiceInvites            ChannelVoiceInvite[]       @relation("VoiceInviteInviter")
  receivedVoiceInvites        ChannelVoiceInvite[]       @relation("VoiceInviteInvitee")

  liveStreamsHosted       LiveStream[]
  liveStreamsWatching     LiveStreamViewer[]
  liveStreamStageRequests LiveStreamStageRequest[]
  liveStreamComments      LiveStreamComment[]

  stories        Story[]
  storyViews     StoryView[]
  storyReactions StoryReaction[]
  adCampaigns    AdCampaign[]

  sentConnections     Connection[] @relation("ConnectionRequester")
  receivedConnections Connection[] @relation("ConnectionTarget")

  // Subscriptions: one-directional "follow" — distinct from Connection
  // (mutual, intent-tag-gated). subscriptions = who I subscribe to;
  // subscribers = who subscribes to me.
  subscriptions Subscription[] @relation("SubscriptionSubscriber")
  subscribers   Subscription[] @relation("SubscriptionTarget")

  sentMessages         Message[]            @relation("MessageSender")
  conversations        ConversationMember[]
  messageReactions     MessageReaction[]
  messageCorrections   MessageCorrection[]
  createdConversations Conversation[]       @relation("ConversationCreator")
  groupJoinRequests    GroupJoinRequest[]

  reportsFiled    Report[] @relation("ReportsFiled")
  reportsReceived Report[] @relation("ReportsReceived")

  auditLogEntries AuditLog[] @relation("AuditLogTarget")

  likes            Like[]
  comments         Comment[]
  commentReactions CommentReaction[]
  postReactions    PostReaction[]
  shares           Share[]
  postRsvps        PostRsvp[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")

  passwordResetTokens PasswordResetToken[]

  callsMade     Call[] @relation("CallCaller")
  callsReceived Call[] @relation("CallCallee")

  blocksMade        Block[]            @relation("Blocker")
  blocksReceived    Block[]            @relation("Blocked")
  pushSubscriptions PushSubscription[]
  fcmTokens         FcmToken[]
  analyticsEvents   AnalyticsEvent[]

  @@index([country])
  // Matches the discover page's actual query shape (status + discoverable
  // equality filters, ordered by trustScore) — without this, that query
  // forces a full scan + sort as the user table grows.
  @@index([status, discoverable, trustScore])
  // Same reasoning, for Discover's "Online now" sort (status + discoverable
  // equality filters, lastSeenAt range + order).
  @@index([status, discoverable, lastSeenAt])
}

enum CircleVisibility {
  PUBLIC
  PRIVATE
}

model Circle {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String           @db.Text
  // Up to 5 categories per Circle (see circleSchema in lib/validations.ts) —
  // stored as an array even though most Circles pick just one, so search/
  // filtering/embeddings all treat it uniformly.
  category      String[]
  coverImageUrl String?
  visibility    CircleVisibility @default(PUBLIC)
  createdById   String
  createdAt     DateTime         @default(now())

  // See User.embedding — embeds name+description+category.
  embedding Unsupported("vector(1536)")?

  createdBy     User                @relation("CircleOwner", fields: [createdById], references: [id], onDelete: Cascade)
  members       CircleMembership[]
  joinRequests  CircleJoinRequest[]
  posts         Post[]
  channels      Channel[]
  notifications Notification[]
  liveStreams   LiveStream[]

  @@index([category], type: Gin)
}

/**
 * Mirrors GroupJoinRequest (used for private Conversations) — a PRIVATE Circle's owner/co-admins approve or decline these instead of joinCircle adding a member instantly.
 */
model CircleJoinRequest {
  id          String            @id @default(cuid())
  circleId    String
  userId      String
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([circleId, status])
}

enum CircleRole {
  MEMBER
  MODERATOR
  OWNER
}

model CircleMembership {
  id       String     @id @default(cuid())
  userId   String
  circleId String
  role     CircleRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId])
  // The unique constraint above is userId-leading, so it doesn't serve
  // circleId-first lookups — matches how joinCircle filters co-admins by
  // circleId+role on every join, and how /circles now includes a
  // per-viewer membership per Circle card.
  @@index([circleId, role])
}

enum ChannelType {
  TEXT
  VOICE
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

/**
 * A labelled sub-room within a Circle — text channels carry Posts, voice
 * channels carry a persistent Daily.co room (voiceRoomName/voiceRoomUrl,
 * only meaningful when type=VOICE). Every Circle always has at least one
 * TEXT channel (slug "general", auto-created by createCircle and, for
 * Circles that predate this model, by the backfill migration).
 */
model Channel {
  id          String            @id @default(cuid())
  circleId    String
  name        String
  slug        String
  topic       String?           @db.Text
  type        ChannelType
  visibility  ChannelVisibility @default(PUBLIC)
  position    Int               @default(0)
  createdById String
  createdAt   DateTime          @default(now())

  voiceRoomName String?
  voiceRoomUrl  String?

  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  posts             Post[]
  members           ChannelMembership[]
  voiceParticipants ChannelVoiceParticipant[]
  voiceInvites      ChannelVoiceInvite[]
  notifications     Notification[]

  @@unique([circleId, slug])
  @@index([circleId, position])
}

/**
 * A social invite to join a voice Channel's room — distinct from
 * ChannelVoiceParticipant (presence-only, exists only while actually in the
 * room). Mirrors CollabInvite's shape/lifecycle. Accepting is a pure RSVP:
 * it doesn't itself add a ChannelVoiceParticipant row, the invitee still
 * calls joinCircleVoiceRoom separately when ready.
 */
model ChannelVoiceInvite {
  id          String           @id @default(cuid())
  channelId   String
  inviterId   String
  inviteeId   String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  inviter User    @relation("VoiceInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User    @relation("VoiceInviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([channelId, inviteeId])
  @@index([channelId, status])
  @@index([inviteeId, status])
}

/**
 * Explicit allow-list, only ever populated for PRIVATE channels — a PUBLIC
 * channel has no rows here at all, since access is just "any CircleMembership".
 */
model ChannelMembership {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  addedAt   DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
}

/**
 * Presence, not history — a row exists only while that member is currently
 * in this voice channel's room. Same shape as CollabSessionParticipant,
 * scoped per Channel rather than per Circle so a Circle can have several
 * simultaneous voice rooms.
 */
model ChannelVoiceParticipant {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
}

enum ModerationStatus {
  PUBLISHED
  FLAGGED
  REMOVED
}

enum PostMediaType {
  NONE
  IMAGE
  VIDEO
  EMBED
  LINK
}

enum EmbedProvider {
  YOUTUBE
  VIMEO
  TIKTOK
  DAILYMOTION
}

model Post {
  id                  String           @id @default(cuid())
  authorId            String
  circleId            String?
  // Set alongside circleId whenever the post was made in a specific text
  // Channel — circleId itself is still always set too (derived from
  // channel.circleId at write time) so every existing circleId-scoped query/
  // index (home feed, moderation queue, admin/circles) keeps working
  // untouched; channelId only narrows within that.
  channelId           String?
  content             String           @db.Text
  mediaType           PostMediaType    @default(NONE)
  mediaUrls           String[]         @default([])
  videoUrl            String?
  videoThumbnailUrl   String?
  // Video-body moderation (src/lib/hive.ts, called synchronously from the
  // moderate-videos cron) — separate from moderationStatus, which is still
  // driven by the caption+thumbnail check at publish time
  // (src/lib/moderation.ts). Set once Hive's verdict is in; doubles as the
  // "needs checking" filter — null means still pending (or Hive not
  // configured, in which case it stays null forever and is simply never
  // picked up by the cron).
  videoModeratedAt    DateTime?
  // EMBED posts store only a provider + the extracted video id, never the
  // raw pasted URL — the iframe src is always rebuilt server-side from these
  // two known-safe values, so nothing attacker-controlled ever becomes an
  // iframe src.
  embedProvider       EmbedProvider?
  embedId             String?
  // LINK posts: any http(s) URL that isn't a recognized video provider,
  // stored raw and rendered only as a plain <a href> (never an iframe src,
  // unlike embedProvider/embedId above) — protocol-checked at write time in
  // normalizeLinkUrl().
  linkUrl             String?
  intentTag           IntentTag?
  // Which Home feed section this post is filed under (src/app/home/page.tsx).
  feedCategory        FeedCategory     @default(GENERAL)
  moderationStatus    ModerationStatus @default(PUBLISHED)
  eventAt             DateTime?
  eventLocation       String?
  // Set once a "starts soon" reminder has gone out (see the event-reminders
  // cron route) so the same event never notifies attendees twice.
  eventReminderSentAt DateTime?
  createdAt           DateTime         @default(now())
  editedAt            DateTime?

  // See User.embedding — embeds content only.
  embedding Unsupported("vector(1536)")?

  repostOfId String?

  // Set when this post is a "share into a Circle" of another post — unlike
  // repostOfId, never unique per (authorId, sharedPostId): a user can share
  // the same post into multiple Circles, or the same Circle more than once,
  // so sharing must not carry repost's toggle/undo semantics (see
  // shareToCircle in actions/shares.ts).
  sharedPostId String?

  likeCount    Int @default(0)
  commentCount Int @default(0)
  repostCount  Int @default(0)
  shareCount   Int @default(0)
  rsvpCount    Int @default(0)

  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  circle      Circle?  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  repostOf    Post?    @relation("PostRepost", fields: [repostOfId], references: [id], onDelete: Cascade)
  reposts     Post[]   @relation("PostRepost")
  sharedPost  Post?    @relation("PostShare", fields: [sharedPostId], references: [id], onDelete: Cascade)
  shareEmbeds Post[]   @relation("PostShare")

  likes         Like[]
  reactions     PostReaction[]
  comments      Comment[]
  shares        Share[]
  rsvps         PostRsvp[]
  notifications Notification[]

  @@unique([authorId, repostOfId])
  @@index([circleId])
  @@index([authorId])
  @@index([repostOfId])
  @@index([sharedPostId])
  // Match the home feed's actual query shape (each OR branch filtered by
  // moderationStatus, the whole result ordered by createdAt) — without
  // these, that OR+sort increasingly needs to sort a large intermediate
  // row set as a user's circle/connection graph grows.
  @@index([circleId, moderationStatus, createdAt])
  @@index([authorId, moderationStatus, createdAt])
  // Matches a channel's own feed query shape, same reasoning as the
  // circleId-scoped index above.
  @@index([channelId, moderationStatus, createdAt])
  // Backs the event-reminders cron's recurring range scan (eventAt between
  // now and the reminder window, reminder not yet sent).
  @@index([eventAt])
  // Matches each category section's own feed query shape on Home, same
  // reasoning as the circleId/authorId composite indexes above.
  @@index([feedCategory, moderationStatus, createdAt])
  // Backs the moderate-videos cron's scan for video posts still awaiting a
  // Hive verdict (mediaType VIDEO, videoModeratedAt IS NULL).
  @@index([mediaType, videoModeratedAt])
}

model Comment {
  id               String           @id @default(cuid())
  postId           String
  authorId         String
  parentId         String?
  content          String           @db.Text
  moderationStatus ModerationStatus @default(PUBLISHED)
  createdAt        DateTime         @default(now())
  editedAt         DateTime?

  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)

  replies       Comment[]         @relation("CommentReplies")
  notifications Notification[]
  reactions     CommentReaction[]

  @@index([postId, createdAt])
  @@index([parentId])
}

/**
 * One active emoji reaction per user per comment — same shape as
 * MessageReaction (picking a new emoji replaces it, re-picking the same one
 * removes it).
 */
model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

/**
 * One active emoji reaction per user per post — separate from Like (the
 * heart), same shape as CommentReaction/MessageReaction: picking a new
 * emoji replaces it, re-picking the same one removes it.
 */
model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

/**
 * Presence of a row = "going", same one-per-user-per-post shape as Like — no separate status enum.
 */
model PostRsvp {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Share {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  POST_LIKE
  POST_COMMENT
  // Sent to a comment's author when someone replies to that comment
  // specifically (as opposed to POST_COMMENT, sent to the post's author for
  // any top-level or nested comment) — see createComment in actions/comments.ts.
  COMMENT_REPLY
  POST_REPOST
  POST_SHARE
  EVENT_RSVP
  // Sent to a Circle's creator and any co-admins when a new member joins.
  CIRCLE_JOINED
  // Sent to every site admin (isAdmin=true) when any user creates a new Circle.
  CIRCLE_CREATED
  // Sent to an event post's author and RSVP'd attendees shortly before eventAt.
  EVENT_REMINDER
  // Sent to a PRIVATE Circle's owner and co-admins when someone requests to join.
  CIRCLE_JOIN_REQUEST
  // Sent to the requester when their CircleJoinRequest is approved.
  CIRCLE_JOIN_APPROVED
  // Sent to every other member of a conversation when a message arrives —
  // in-app only (see createMessageNotifications in actions/messages.ts),
  // so it shows up in the notification bell alongside everything else
  // rather than only in the Messages tab's own unread badge.
  MESSAGE
  // Sent to a member when an existing member adds them to a group chat
  // (see addGroupMembers in actions/messages.ts).
  GROUP_ADDED
  // Sent to a collab's author and any co-admins when a new participant
  // joins — same shape as CIRCLE_JOINED (see joinCollab in actions/collab.ts).
  COLLAB_JOINED
  // Sent to every subscriber when a user they subscribe to creates a new
  // Post — fan-out on createPost, see actions/circles.ts.
  SUBSCRIPTION_POST
  // Same as SUBSCRIPTION_POST but for a new Story — fan-out on createStory,
  // see actions/stories.ts.
  SUBSCRIPTION_STORY
  // Sent to every subscriber when a user they subscribe to reposts a post.
  SUBSCRIPTION_REPOST
  // Sent to every subscriber when a user they subscribe to starts a live
  // stream.
  SUBSCRIPTION_LIVE
  // Sent to every subscriber when a user they subscribe to RSVPs to an
  // event post.
  SUBSCRIPTION_RSVP
  // Sent to every subscriber when a user they subscribe to joins a Circle.
  SUBSCRIPTION_CIRCLE_JOINED
  // Sent to every subscriber when a user they subscribe to creates a new
  // Circle.
  SUBSCRIPTION_CIRCLE_CREATED
  // Sent to a PUBLIC collab's organizer and any co-admins when someone
  // requests to join — same shape as CIRCLE_JOIN_REQUEST.
  COLLAB_JOIN_REQUEST
  // Sent to the requester when their CollabJoinRequest is approved.
  COLLAB_JOIN_APPROVED
  // Sent to a specific user when a PRIVATE collab's organizer/co-admin
  // invites them (see inviteToCollab in actions/collab.ts).
  COLLAB_INVITE
  // Sent to the inviter when their CollabInvite is accepted.
  COLLAB_INVITE_ACCEPTED
  // Sent to a specific circle member when another member invites them to
  // join a voice Channel's room (see inviteToVoiceChannel in actions/circle-voice.ts).
  VOICE_CHANNEL_INVITE
  // Sent to the inviter when their ChannelVoiceInvite is accepted.
  VOICE_CHANNEL_INVITE_ACCEPTED
}

model Notification {
  id             String           @id @default(cuid())
  recipientId    String
  actorId        String
  type           NotificationType
  postId         String?
  commentId      String?
  connectionId   String?
  circleId       String?
  conversationId String?
  collabId       String?
  storyId        String?
  subscriptionId String?
  liveStreamId   String?
  channelId      String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  recipient    User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor        User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post         Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  connection   Connection?      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  circle       Circle?          @relation(fields: [circleId], references: [id], onDelete: Cascade)
  conversation Conversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  collab       CollabBoardPost? @relation(fields: [collabId], references: [id], onDelete: Cascade)
  story        Story?           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  subscription Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  liveStream   LiveStream?      @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  channel      Channel?         @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

enum CollabStatus {
  OPEN
  CLOSED
}

enum CollabVisibility {
  PUBLIC
  PRIVATE
}

model CollabBoardPost {
  id          String           @id @default(cuid())
  authorId    String
  title       String
  description String           @db.Text
  // Free-text (like Circle.category), not an enum — an open-ended,
  // searchable set of collaboration types (see COLLAB_TYPES in
  // collab-types.ts) rather than a small fixed list needing a migration
  // every time a new type is wanted.
  type        String
  // Mutually exclusive with `countries`: worldwide posts ignore it entirely
  // (kept empty) rather than requiring every country to be enumerated.
  worldwide   Boolean          @default(false)
  countries   String[]         @default([])
  status      CollabStatus     @default(OPEN)
  // PUBLIC collabs are listed/searched by everyone and gate joining behind a
  // CollabJoinRequest the organizer screens. PRIVATE collabs are never
  // listed/searched — the organizer invites specific users via CollabInvite
  // instead, and only the organizer + invited/joined users can see it at all
  // (see canViewCollab in collab-permissions.ts).
  visibility  CollabVisibility @default(PUBLIC)
  createdAt   DateTime         @default(now())

  // See User.embedding — embeds title+description.
  embedding Unsupported("vector(1536)")?

  // Live session room — lazily created on first join, same pattern as
  // Circle.voiceRoomName/voiceRoomUrl (see joinCollabSession).
  roomName String?
  roomUrl  String?

  // Group chat backing in-session text/photo/video posting — lazily created
  // on first join and reuses the existing Conversation/Message pipeline
  // (see joinCollab) instead of a bespoke media feed.
  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  author              User                       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  participants        CollabParticipant[]
  sessionParticipants CollabSessionParticipant[]
  joinRequests        CollabJoinRequest[]
  invites             CollabInvite[]
  notifications       Notification[]

  @@index([type])
  @@index([status])
  @@index([visibility])
}

/**
 * Mirrors CircleJoinRequest — a PUBLIC collab's organizer/co-admins approve or decline these instead of joinCollab adding a participant instantly.
 */
model CollabJoinRequest {
  id          String            @id @default(cuid())
  collabId    String
  userId      String
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?

  collab CollabBoardPost @relation(fields: [collabId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collabId, userId])
  @@index([collabId, status])
}

/**
 * Mirrors Connection's PENDING/ACCEPTED/DECLINED handshake — a PRIVATE collab's organizer/co-admins target specific users here instead of them self-requesting.
 */
model CollabInvite {
  id          String           @id @default(cuid())
  collabId    String
  inviterId   String
  inviteeId   String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  collab  CollabBoardPost @relation(fields: [collabId], references: [id], onDelete: Cascade)
  inviter User            @relation("CollabInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User            @relation("CollabInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([collabId, inviteeId])
  @@index([collabId, status])
  @@index([inviteeId, status])
}

enum CollabRole {
  PARTICIPANT
  MODERATOR
  OWNER
}

/**
 * Static "joined this collaboration" membership — mirrors CircleMembership.
 */
model CollabParticipant {
  id       String     @id @default(cuid())
  userId   String
  collabId String
  role     CollabRole @default(PARTICIPANT)
  joinedAt DateTime   @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  collab CollabBoardPost @relation(fields: [collabId], references: [id], onDelete: Cascade)

  @@unique([userId, collabId])
  @@index([collabId, role])
}

/**
 * Presence, not history — a row exists only while that participant is
 * currently in the collab's live session room. Mirrors CircleVoiceParticipant.
 */
model CollabSessionParticipant {
  id       String   @id @default(cuid())
  collabId String
  userId   String
  joinedAt DateTime @default(now())

  collab CollabBoardPost @relation(fields: [collabId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collabId, userId])
  @@index([collabId])
}

enum LiveStreamStatus {
  LIVE
  ENDED
}

/**
 * VIEWER is watch-only; GUEST/COHOST can unmute camera/mic (see createLiveStreamRoom's owner_only_broadcast + createMeetingToken's permissions).
 */
enum LiveStreamRole {
  VIEWER
  GUEST
  COHOST
}

/**
 * A host-broadcasts/viewers-watch WebRTC room (see createLiveStreamRoom's
 * owner_only_broadcast Daily property) — unlike Collab's persistent session
 * room, each live stream is a one-off, ends explicitly (or via room expiry),
 * and is never reused.
 */
model LiveStream {
  id        String           @id @default(cuid())
  hostId    String
  circleId  String?
  title     String
  status    LiveStreamStatus @default(LIVE)
  roomName  String
  roomUrl   String
  startedAt DateTime         @default(now())
  endedAt   DateTime?
  // Bumped by recordLiveStreamHeartbeat whenever the host or a COHOST polls
  // while the stream is open — always holds the most recent activity among
  // all of them (see the auto-end-inactive-streams cron), never per-user.
  lastHostActivityAt DateTime?

  host          User                     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  circle        Circle?                  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  viewers       LiveStreamViewer[]
  stageRequests LiveStreamStageRequest[]
  notifications Notification[]
  comments      LiveStreamComment[]

  @@index([status])
  @@index([hostId])
}

/**
 * A live text-chat message on a Go Live stream — separate from Daily's own
 * built-in room chat (enabled on every room, see createLiveStreamRoom, but
 * that lives inside Daily's cross-origin prebuilt iframe and can't be
 * restyled/positioned by this app). This is what actually backs the
 * always-visible scrolling comment feed on the stream itself. Polled, not a
 * persistent chat archive — same "presence-ish, not a durable thread" spirit
 * as LiveStreamViewer, though rows aren't deleted on cascade-independent
 * cleanup the way presence rows are; they just stop being polled once the
 * stream ends.
 */
model LiveStreamComment {
  id           String   @id @default(cuid())
  liveStreamId String
  authorId     String
  content      String   @db.Text
  createdAt    DateTime @default(now())

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([liveStreamId, createdAt])
}

/**
 * Presence, not history — mirrors CollabSessionParticipant. Despite the name,
 * this now covers everyone present (watch-only viewers as well as
 * GUEST/COHOST stage participants) — `role` distinguishes them. The host's
 * own row is also stored here (role is irrelevant for them, since isOwner
 * comes from LiveStream.hostId directly) but is excluded from viewer/stage
 * tallies in the live-streams actions.
 */
model LiveStreamViewer {
  id           String         @id @default(cuid())
  liveStreamId String
  userId       String
  role         LiveStreamRole @default(VIEWER)
  joinedAt     DateTime       @default(now())

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveStreamId, userId])
  @@index([liveStreamId])
}

/**
 * A pending ask to move from plain VIEWER onto the stage as GUEST/COHOST —
 * mirrors GroupJoinRequest/CollabJoinRequest's PENDING/APPROVED/DECLINED
 * shape. joinLiveStream creates one of these instead of granting the stage
 * role outright; only respondToStageRequest (host-only) turns an APPROVED
 * request into an actual LiveStreamViewer role change (and, from there, the
 * existing canSend grant in live-stream-room.tsx picks it up on its next
 * poll). Kept separate from LiveStreamViewer rather than adding a "pending"
 * role there, so presence (who's in the room) and the approval workflow
 * (who asked to be on stage) don't get tangled into one enum.
 */
model LiveStreamStageRequest {
  id           String            @id @default(cuid())
  liveStreamId String
  userId       String
  role         LiveStreamRole
  status       JoinRequestStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  respondedAt  DateTime?

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveStreamId, userId])
  @@index([liveStreamId, status])
}

enum StoryMediaType {
  IMAGE
  VIDEO
}

/**
 * A profile story — always has a media file (unlike a Post, which can be text-only) and disappears 24h after posting.
 */
model Story {
  id                String         @id @default(cuid())
  authorId          String
  mediaType         StoryMediaType
  mediaUrl          String
  mediaThumbnailUrl String?
  caption           String?        @db.Text
  createdAt         DateTime       @default(now())
  expiresAt         DateTime

  author        User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views         StoryView[]
  reactions     StoryReaction[]
  replies       Message[]
  notifications Notification[]

  // Backs both "my active stories" (profile page) and the expiry cron's
  // sweep for rows past expiresAt.
  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

/**
 * One active emoji reaction per user per story — same toggle shape as
 * MessageReaction/CommentReaction (picking a new emoji replaces it,
 * re-picking the same one removes it). Aggregate counts are visible to
 * anyone who can see the story; who-reacted-what is author-only (see
 * getStoryViewers).
 */
model StoryReaction {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
}

/**
 * Presence of a row = "this viewer has seen this story" — same one-row-per-
 * (target, viewer) shape as Like/PostRsvp. The author's own views of their
 * own story are never recorded here (see viewStory).
 */
model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([storyId])
}

enum AdMediaType {
  IMAGE
  VIDEO
}

enum AdStatus {
  DRAFT
  // Checkout session created, waiting on the Stripe webhook to confirm payment.
  PENDING_PAYMENT
  // Paid, waiting on an admin to approve the creative before it goes live.
  PENDING_REVIEW
  ACTIVE
  REJECTED
  // Approved and previously live, then pulled early (policy issue found
  // after launch, or the advertiser asked to stop) — distinct from
  // REJECTED, which never ran at all.
  PAUSED
  COMPLETED
}

/**
 * A paid ad booking. Deliberately not tied to a User — the public /advertise
 * page takes bookings from companies with no YuKon3t account, so contact
 * info is captured directly here; advertiserUserId is just an optional link
 * for the rare case someone books while signed in.
 */
model AdCampaign {
  id               String  @id @default(cuid())
  advertiserUserId String?

  companyName  String
  contactName  String
  contactEmail String

  headline  String
  body      String      @db.Text
  linkUrl   String
  mediaType AdMediaType
  mediaUrl  String

  durationDays Int
  startAt      DateTime?
  endAt        DateTime?

  priceCents Int
  currency   String @default("usd")

  status          AdStatus  @default(DRAFT)
  rejectionReason String?   @db.Text
  reviewedAt      DateTime?
  reviewedBy      String?

  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  refundedAt              DateTime?

  impressionCount Int @default(0)
  clickCount      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  advertiserUser User? @relation(fields: [advertiserUserId], references: [id], onDelete: SetNull)

  @@index([status])
  // Backs the display slot's "any currently-running ad" query.
  @@index([status, startAt, endAt])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  targetId    String
  intentTag   IntentTag
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("ConnectionTarget", fields: [targetId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@unique([requesterId, targetId])
  @@index([targetId])
}

/**
 * One-directional "follow" — subscribing to a user needs no approval (unlike
 * Connection's PENDING/ACCEPTED handshake) and grants no DM conversation.
 * Subscribing to someone notifies you (SUBSCRIPTION_POST/SUBSCRIPTION_STORY)
 * whenever they post new content — see the fan-out in createPost/createStory.
 */
model Subscription {
  id             String   @id @default(cuid())
  subscriberId   String
  subscribedToId String
  createdAt      DateTime @default(now())

  subscriber   User @relation("SubscriptionSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  subscribedTo User @relation("SubscriptionTarget", fields: [subscribedToId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@unique([subscriberId, subscribedToId])
  @@index([subscribedToId])
  @@index([subscriberId])
}

model Conversation {
  id           String   @id @default(cuid())
  isGroup      Boolean  @default(false)
  name         String?
  discoverable Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())

  // Smart search for Discover groups (src/lib/search-embeddings.ts) as a
  // fallback when exact substring search on the group name comes back
  // sparse. See User.embedding — same Unsupported/$queryRaw pattern, embeds
  // name only (groups have no description field).
  embedding Unsupported("vector(1536)")?

  createdBy       User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members         ConversationMember[]
  messages        Message[]
  joinRequests    GroupJoinRequest[]
  collabBoardPost CollabBoardPost?
  notifications   Notification[]
}

model GroupJoinRequest {
  id             String            @id @default(cuid())
  conversationId String
  userId         String
  status         JoinRequestStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  respondedAt    DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId, status])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model ConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

enum MessageMediaType {
  NONE
  AUDIO
  VIDEO
  IMAGE
}

model Message {
  id                   String           @id @default(cuid())
  conversationId       String
  senderId             String
  content              String           @db.Text
  mediaType            MessageMediaType @default(NONE)
  mediaUrl             String?
  mediaThumbnailUrl    String?
  moderationStatus     ModerationStatus @default(PUBLISHED)
  deliveredAt          DateTime?
  readAt               DateTime?
  deletedForEveryoneAt DateTime?
  deletedForUserIds    String[]         @default([])
  editedAt             DateTime?
  createdAt            DateTime         @default(now())

  // Set when this message is a reply to a story (see replyToStory) — lets
  // the chat thread show a "Replied to your story" reference above the
  // bubble. SetNull rather than cascading: the story disappearing 24h
  // later shouldn't delete the conversation history of the reply itself.
  storyId String?

  // Set when the sender swiped/replied to an earlier message in this same
  // thread (see swipe-to-reply in chat-thread.tsx) — shows a quoted preview
  // above the bubble, same idea as storyId above. SetNull, not Cascade: the
  // quoted message being deleted-for-everyone (which soft-deletes it, see
  // deleteMessageForEveryone) already clears its content, so the reply just
  // renders "Original message deleted" rather than losing its own history.
  replyToMessageId String?

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  story        Story?              @relation(fields: [storyId], references: [id], onDelete: SetNull)
  replyTo      Message?            @relation("MessageReplyTo", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]           @relation("MessageReplyTo")
  reactions    MessageReaction[]
  corrections  MessageCorrection[]

  // Every message query filters on conversationId and sorts/paginates on
  // createdAt together (getConversationMessages, the collab board, the
  // /messages/[id] SSR load) — the compound index serves that access
  // pattern directly instead of falling back to the single-column index
  // plus an in-memory sort.
  @@index([conversationId, createdAt])
  @@index([replyToMessageId])
}

/**
 * One active correction suggestion per (message, corrector) — resubmitting updates it rather than stacking duplicates.
 */
model MessageCorrection {
  id            String   @id @default(cuid())
  messageId     String
  authorId      String
  correctedText String   @db.Text
  createdAt     DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([messageId, authorId])
  @@index([messageId])
}

/**
 * One active emoji reaction per user per message — picking a new emoji replaces it, re-picking the same one removes it.
 */
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

enum ReportTargetType {
  USER
  POST
  MESSAGE
  CIRCLE
  COLLAB_POST
  COMMENT
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportReasonCategory {
  SPAM
  SCAM_OR_FRAUD
  PHISHING
  HARASSMENT
  FAKE_ACCOUNT
  INAPPROPRIATE_CONTENT
  OTHER
}

model Report {
  id             String               @id @default(cuid())
  reporterId     String
  reportedUserId String?
  targetType     ReportTargetType
  targetId       String
  reasonCategory ReportReasonCategory @default(OTHER)
  reason         String               @db.Text
  status         ReportStatus         @default(OPEN)
  resolutionNote String?              @db.Text
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?

  reporter     User  @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum AuditAction {
  WARN
  SUSPEND
  BAN
  REINSTATE
  REPORT_DISMISSED
  REPORT_RESOLVED
  ACCOUNT_DELETED
  CONTENT_REMOVED
  PASSWORD_RESET_SENT
  VERIFICATION_EMAIL_SENT
}

model AuditLog {
  id          String      @id @default(cuid())
  targetId    String
  action      AuditAction
  reason      String      @db.Text
  performedBy String
  createdAt   DateTime    @default(now())

  target User @relation("AuditLogTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
}

// Deliberately has no relation (just plain string fields) to the account it
// records the deletion of — an AuditLog row FK'd to that user would cascade
// away the instant the user is deleted, erasing the very record of why,
// which defeats the point for this one action specifically.
/**
 * Admin-authored "what's new" post. createdById is deliberately a plain
 * string (no relation), same reasoning as AccountDeletionLog/
 * AuditLog.performedBy — an announcement should survive the authoring
 * admin's account ever being deleted, not cascade away with it.
 */
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String   @db.Text
  createdById String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model AccountDeletionLog {
  id              String   @id @default(cuid())
  deletedUserId   String
  deletedEmail    String
  deletedUsername String?
  reason          String   @db.Text
  performedBy     String
  createdAt       DateTime @default(now())
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACCEPTED
  DECLINED
  ENDED
  MISSED
}

model Call {
  id          String     @id @default(cuid())
  callerId    String
  calleeId    String
  type        CallType
  status      CallStatus @default(RINGING)
  roomName    String
  roomUrl     String
  // Minted for the callee at startCall time (alongside the caller's own
  // token), not on-demand when they accept — a live Daily REST round trip
  // used to sit on the critical path between the callee tapping Accept and
  // the call actually connecting. Nullable so a Call row that somehow never
  // got one (token mint failure path) still falls back to minting on accept.
  calleeToken String?
  createdAt   DateTime   @default(now())
  // Set the first time the callee's own client (IncomingCallListener, polled
  // app-wide while signed in) actually observes this RINGING call — i.e. the
  // callee is online and their device is genuinely ringing right now, not
  // just that a push notification was sent to a possibly-offline device.
  // Lets the caller's UI say "Ringing" instead of a static "Calling" the
  // whole time. Stays null if the callee never has an active session to
  // notice the call before it's answered/declined/missed.
  ringingAt   DateTime?
  respondedAt DateTime?
  endedAt     DateTime?

  caller User @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee User @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([calleeId, status])
  @@index([callerId, status])
}

/**
 * One-directional; "blocked either way" checks look at both directions. Blocking severs any existing connection between the two (see blockUser).
 */
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/**
 * One row per subscribed browser/device (Web Push), not per user — a user can have several.
 */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * One row per registered Android device (Firebase Cloud Messaging) — separate
 * from PushSubscription (Web Push/VAPID) because the shape is different (a
 * single opaque token vs. an endpoint + keypair) and because native call
 * notifications go through FCM's data-message path, not the browser
 * Notification API, so the two need to be sent independently. See
 * src/lib/fcm.ts.
 */
model FcmToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AnalyticsEventType {
  SIGN_UP
  SIGN_IN
  POST_CREATED
  CONNECTION_REQUESTED
  CONNECTION_ACCEPTED
  MESSAGE_SENT
  CALL_STARTED
  CIRCLE_JOINED
  CIRCLE_CREATED
  SUBSCRIBED
}

/**
 * Lightweight first-party product-usage log — not a PII/session tracker. userId is nullable and SetNull on delete so a deleted account doesn't need to touch this table.
 */
model AnalyticsEvent {
  id        String             @id @default(cuid())
  userId    String?
  type      AnalyticsEventType
  metadata  Json?
  createdAt DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId])
}
