<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Notification-tap deep link for incoming calls raised by
                 CallForegroundService/CallActionReceiver — a plain custom
                 scheme (not an https App Link) since it's only ever opened
                 from within this app's own notifications, so no
                 assetlinks.json domain verification is needed. Read by
                 incoming-call-listener.tsx via @capacitor/app's
                 getLaunchUrl()/appUrlOpen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yukon3t" android:host="call" />
            </intent-filter>

            <!-- Share target: lets other apps' Share sheets offer "YuKon3t"
                 as a destination for a single image/video/audio file or
                 plain text (a shared link/post). Captured by
                 ShareReceiverPlugin.java (set from MainActivity's
                 onCreate/onNewIntent, same pattern as handleCallDeepLink
                 above) and read from the JS side via share-receiver.ts's
                 checkForPendingShare(), which ShareTargetGate.tsx calls on
                 launch. Multiple <data> tags in one intent-filter combine as
                 OR, so this doesn't need one block per MIME type. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Multiple images/videos at once (e.g. a multi-select from
                 Gallery) — same handling, just EXTRA_STREAM as an
                 ArrayList<Uri> instead of a single Uri. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

        </activity>

        <!-- Handles every FCM message for this app, including
             incoming_call/call_cancelled data pushes (src/lib/fcm.ts) while
             backgrounded/asleep — see CallMessagingService's own doc
             comment. Android/Firebase does NOT reliably support two
             manifest-declared FirebaseMessagingService subclasses sharing
             the same MESSAGING_EVENT intent-filter: confirmed live via
             adb logcat that a real incoming call's FCM push produced zero
             trace of either service's own log tags firing at all — the
             platform silently resolves the implicit intent to exactly one
             of them, and which one is not something this app controls or
             can rely on. The <service tools:node="remove"> below removes
             @capacitor-firebase/messaging's own manifest-merged
             MessagingService entirely so there is only ever one candidate;
             CallMessagingService.onMessageReceived/onNewToken now also
             forward to FirebaseMessagingPlugin's own static handlers
             (the exact same calls that service's onMessageReceived/
             onNewToken made) so token issuance and the plugin's own JS
             listeners keep working unchanged. -->
        <service
            android:name=".CallMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name="io.capawesome.capacitorjs.plugins.firebase.messaging.MessagingService"
            tools:node="remove" />

        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="phoneCall" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- White silhouette shown in the status bar for FCM notifications
             (see @capacitor-firebase/messaging's README) — without this,
             Android falls back to a flattened version of the full-color app
             icon, which renders as a plain white square/circle. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera capture for posts, profile picture, and video calls
         (@capacitor/camera). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Runtime notification permission required on Android 13+ before FCM
         push can be delivered (@capacitor-firebase/messaging). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Audio capture for voice/video calls and recording video posts,
         matching NSMicrophoneUsageDescription on iOS. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Access to the device contact list for the "Choose from contacts"
         invite flow (@capacitor-community/contacts) — matching
         NSContactsUsageDescription on iOS. This app's own code only ever
         calls the plugin's read method (Contacts.getContacts, in
         invite-panel.tsx) to build an invite list — it never creates,
         edits, or deletes a contact. WRITE_CONTACTS is still required
         here anyway: confirmed live, the plugin declares READ_CONTACTS
         and WRITE_CONTACTS together under one "contacts" permission alias
         (ContactsPlugin.java) and its native-side permission check
         validates the *whole* alias is declared in the manifest before
         allowing any call under it, READ included — omitting
         WRITE_CONTACTS made every attempt fail with "Missing the
         following permissions in AndroidManifest.xml: WRITE_CONTACTS"
         even though the request itself was only ever a read. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Normal permissions (granted at install, no runtime prompt) for the
         voice/video call feature. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- CallForegroundService: keeps the process Doze-exempt while a call is
         ringing, so the ring isn't delayed/killed while the phone sleeps.
         FOREGROUND_SERVICE_PHONE_CALL is mandatory at target/compile SDK 34+
         for a foregroundServiceType="phoneCall" service; both are "normal"
         permissions granted at install, no runtime prompt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- As of Android 16 (targetSdk 36), starting a foregroundServiceType=
         "phoneCall" service also requires the app to hold this permission
         (or the DIALER role) in addition to FOREGROUND_SERVICE_PHONE_CALL —
         confirmed via on-device logcat: without it, startForeground() throws
         SecurityException "requires ... any of [MANAGE_OWN_CALLS,
         android.app.role.DIALER]" and the ring loses its foreground-service
         Doze exemption. This is the "normal" permission self-managed-calling
         apps (ones that handle their own calls without being a full dialer,
         like this one) declare for exactly this — no runtime prompt, no
         ConnectionService/Telecom integration required just to hold it. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- Lets the incoming-call notification wake/light the screen over the
         lock screen like a real call, instead of a silent background push.
         Google Play treats this as a Restricted Permission requiring a
         declared use case in Play Console (App content > Permissions) —
         see android/SUBMISSION.md before the next release. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Lets CallForegroundPlugin.requestIgnoreBatteryOptimizations() show the
         system "allow app to ignore battery optimizations?" dialog — some
         OEMs (Samsung's One UI "sleeping apps" battery manager, notably) can
         still freeze this process mid-call despite the phoneCall foreground
         service above, and this is the only way to get out from under that
         short of the user finding the equivalent OEM settings screen
         manually. Also a Play Restricted Permission — see
         android/SUBMISSION.md. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
