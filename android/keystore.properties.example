# Copy this file to keystore.properties (already gitignored, never commit
# the copy) and fill in the real values yourself — this file is only read
# locally by android/app/build.gradle, never sent anywhere.
#
# storeFile: absolute path to the .jks/.keystore file. Use forward slashes
# even on Windows (e.g. C:/path/to/file.jks) — backslashes get consumed as
# escape characters by Java's .properties parser and silently break the path.
storeFile=C:/absolute/path/to/your-keystore.jks
storePassword=
keyAlias=
keyPassword=
