# ============================================================
# YuKon3t — Environment Configuration
# Copy this to .env for development (Prisma reads .env by default)
# ============================================================

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="YuKon3t"
NODE_ENV="development"

# Database (PostgreSQL) — local dev via `npx prisma dev`, prod via Neon free tier
# IMPORTANT for prod: use Neon's pooled connection string (the "-pooler"
# hostname, PgBouncer in transaction mode), not the direct endpoint. The app
# runs as serverless functions — many instances each open their own small
# connection pool (see src/lib/prisma.ts), and only a pooler in front of
# Postgres keeps that aggregate under the database's real connection limit.
DATABASE_URL=""
# Optional: per-instance pg Pool size (default 5). Keep this low — it's
# multiplied by however many function instances are running concurrently.
DATABASE_POOL_MAX=""

# Auth (NextAuth v5 — passwordless email magic link)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# OAuth (optional convenience login)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Sign in with Apple (optional; the button on /sign-in and /sign-up is
# simply absent until all four of these are set — see
# src/lib/apple-client-secret.ts). One-time setup in the Apple Developer
# portal (developer.apple.com/account):
#   1. Certificates, Identifiers & Profiles > Identifiers > register an App
#      ID (if this app doesn't have one yet) with the "Sign in with Apple"
#      capability enabled.
#   2. Identifiers > "+" > Services IDs > register one (its identifier,
#      e.g. com.yukon3t.app.signin, is AUTH_APPLE_ID below) > Configure >
#      enable "Sign in with Apple" for it, associate it with the App ID
#      from step 1, and add https://yukon3t.com/api/auth/callback/apple as
#      a Return URL (Apple only accepts a live HTTPS URL — no localhost).
#   3. Keys > "+" > enable "Sign in with Apple" > register > download the
#      .p8 file *once* (Apple never lets you download it again) — its
#      contents go in AUTH_APPLE_PRIVATE_KEY, and the Key ID shown for it
#      is AUTH_APPLE_KEY_ID.
#   4. Your Team ID (top-right of the Apple Developer account page, or
#      Membership details) is AUTH_APPLE_TEAM_ID.
# The client_secret Apple requires is a signed JWT built from these four
# values, generated fresh on demand (not stored) — see
# src/lib/apple-client-secret.ts's own doc comment for why.
AUTH_APPLE_ID=""
AUTH_APPLE_TEAM_ID=""
AUTH_APPLE_KEY_ID=""
# The full .p8 file contents, PEM newlines escaped as literal "\n" — same
# convention as FIREBASE_PRIVATE_KEY below.
AUTH_APPLE_PRIVATE_KEY=""

# Email (Resend) — used for magic links + notifications
RESEND_API_KEY=""
EMAIL_FROM="YuKon3t <onboarding@resend.dev>"

# Rate limiting (Upstash Redis REST — free tier). REQUIRED in production:
# without these, src/lib/rate-limit.ts falls back to a per-instance
# in-memory limiter that doesn't share state across serverless instances —
# effectively no real limit under concurrent load. Create a free database at
# upstash.com and copy its REST URL/token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Web Push (self-generated VAPID key pair — no external account needed;
# generate with `npx web-push generate-vapid-keys`). Enables push
# notifications for incoming calls and new messages; inert without these.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Error monitoring (Sentry — optional). Create a free project at sentry.io
# and copy its DSN. Inert (no code path runs at all) until this is set.
SENTRY_DSN=""
# Same DSN, just NEXT_PUBLIC_-prefixed so the browser bundle (instrumentation-
# client.ts) can read it too — a DSN isn't a secret the way an API key is (it
# only tells the SDK where to send events), so reusing the same value here is
# fine. Powers client-side error capture (src/lib/error-tracking.ts's
# captureError, callable from both server and client code) — inert until set,
# same as SENTRY_DSN above.
NEXT_PUBLIC_SENTRY_DSN=""

# Content moderation (OpenAI Moderation endpoint). Also used for embeddings, dictation and translating posts,
# comments and messages (src/lib/translation-server.ts: Chat Completions); without it "Translate" isn't offered.
OPENAI_API_KEY=""
# Optional: the Chat Completions model used for translation (default gpt-5-mini; e.g. gpt-5-nano for lower cost).
# Set it on both Vercel and Netlify if you change it.
TRANSLATION_MODEL=""
# Live translated captions in 1:1 calls (src/lib/call-captions.ts). Off unless set to 1 (and OPENAI_API_KEY is set).
# Uses OpenAI realtime transcription (WebRTC from the phone, SDP exchanged by the server) and TRANSLATION_MODEL.
# Set on both Vercel and Netlify.
CALL_CAPTIONS_ENABLED=""
# Optional: the realtime transcription model (default gpt-4o-mini-transcribe, about $0.003 per minute of speech).
CALL_CAPTIONS_STT_MODEL=""

# Media storage (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="yukon3t-media"
R2_PUBLIC_URL=""
# View-once ("for your eyes only") photo/video messages (src/app/actions/
# view-once.ts). A SECOND, PRIVATE bucket in the same R2 account, reached with
# the same R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY (the API token must have
# Object Read & Write on this bucket too). Until this is set the "View once"
# switch is not shown and the actions answer "unavailable". Bucket setup:
#   1. NO public access: no custom domain and the r2.dev URL left disabled.
#      Never reuse R2_BUCKET_NAME or the backup bucket.
#   2. CORS: allow PUT and GET (and HEAD) from every origin the site is
#      served on (https://yukon3t.com, https://www.yukon3t.com,
#      https://yukon3t.vercel.app, https://yukon3t.netlify.app, plus
#      http://localhost:3000 for dev), allowed header Content-Type.
#   3. A lifecycle rule deleting objects 15 days after creation, and one
#      aborting incomplete multipart uploads after 1 day. This is the last
#      line of defence: the app deletes a file when it is viewed, the
#      sweep-view-once cron after that, and unopened ones at 14 days.
# Set it on BOTH Vercel and Netlify.
R2_PRIVATE_BUCKET_NAME=""

# Private profile pictures (see CLAUDE.md "Profile pictures" and src/lib/avatar-url.ts). A staged rollout, OFF by
# default: with AVATAR_PRIVATE unset, deploying this changes nothing. R2_AVATAR_BUCKET_NAME is a THIRD bucket, not
# the view-once one above (that one's 15-day lifecycle rule would delete every profile picture two weeks after it
# was set). Same account and credentials (the API token needs Object Read & Write on it too). Bucket setup:
#   1. NO public access: no custom domain, r2.dev URL left disabled.
#   2. CORS: allow PUT, GET and HEAD from the same origins as the view-once bucket, allowed header Content-Type.
#   3. Lifecycle: NO expiry rule on the bucket as a whole. Optional and recommended: delete objects under the prefix
#      "avatar-upload/" after 1 day (uploads are copied out and deleted at once; this only sweeps abandoned ones),
#      and abort incomplete multipart uploads after 1 day. Never a rule that matches "avatar/".
# AVATAR_PRIVATE=1 then makes NEW profile pictures private (a ~320px thumbnail shown to signed-in users, the ~1080px
# image only to the owner and their connections) and stores them as /api/avatar/... paths. The flag without the
# bucket is inert (logged). Serving private pictures needs only the bucket, so turning the flag back off never breaks
# one. Existing public pictures move with `npm run db:migrate-avatars-private` (dry run first; --apply). This flag and
# the public upload path are removed once Stage 3 (deleting the public copies) is done. Set both on Vercel AND Netlify.
R2_AVATAR_BUCKET_NAME=""
AVATAR_PRIVATE=""

# Automated database backups (src/lib/db-backup.ts, backup-database cron).
# BACKUP_R2_BUCKET_NAME must be a SEPARATE, PRIVATE R2 bucket — never
# R2_BUCKET_NAME above, which is bound to a public URL that serves every
# object in it to anyone. Create a new bucket in the Cloudflare dashboard
# with no public access/custom domain configured, and ideally a separate
# API token scoped only to it (falls back to R2_ACCOUNT_ID/R2_ACCESS_KEY_ID/
# R2_SECRET_ACCESS_KEY above if BACKUP_R2_ACCOUNT_ID/ACCESS_KEY_ID/
# SECRET_ACCESS_KEY aren't set, so one token with access to both buckets
# still works for a minimal setup). BACKUP_ENCRYPTION_KEY encrypts every
# backup (AES-256-GCM) before it leaves this process, independent of the
# bucket's own access controls — generate with `openssl rand -hex 32` and
# store it somewhere durable outside this app (losing it makes every
# existing backup unrecoverable). The cron is a no-op (503) until all of
# these are set. BACKUP_RETENTION_DAYS defaults to 30 if unset.
BACKUP_R2_ACCOUNT_ID=""
BACKUP_R2_ACCESS_KEY_ID=""
BACKUP_R2_SECRET_ACCESS_KEY=""
BACKUP_R2_BUCKET_NAME=""
BACKUP_ENCRYPTION_KEY=""
BACKUP_RETENTION_DAYS="30"

# Voice/video calling (Daily.co) — create an account at daily.co and copy
# your API key. Calling is disabled (buttons still render but startCall
# returns "not_configured") until this is set.
DAILY_API_KEY=""

# Firebase Cloud Messaging — sends a native, ringtone-style call notification
# to the Android app (separate from the Web Push above, which the Android
# app also receives but can only show as a generic browser notification).
# Create a Firebase project, generate a service account key (Project
# settings > Service accounts > Generate new private key), and copy its
# project_id/client_email/private_key fields here. FIREBASE_PRIVATE_KEY must
# keep its literal "\n" sequences (don't unescape them yourself — the code
# does that). Inert until all three are set.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Giphy (GIF search) — get a free API key at https://developers.giphy.com.
# GIF search is disabled (button still renders but returns no results) until this is set.
GIPHY_API_KEY=""

# Google Safe Browsing v4 (link-post safety check, src/lib/link-safety.ts) —
# get a free API key at https://developers.google.com/safe-browsing/v4/get-started.
# Without this, the "Leaving YuKon3t" interstitial before a shared link still
# shows the destination domain (the main defense) but skips the automated
# malware/phishing scan and its warning banner.
GOOGLE_SAFE_BROWSING_API_KEY=""

# Realtime event layer (src/lib/realtime-server.ts / realtime-client.ts) —
# replaces this app's previous polling-based "live" UI (nav badges, chat,
# calls, live streams, voice channels, collab sessions, home feed) with
# Supabase Realtime Broadcast, used purely as a pub/sub signal layer (never
# Supabase Auth or Supabase's own Postgres — this app's data stays on Neon,
# and its own Server Action auth model stays exactly as it is; see
# realtime-server.ts's doc comment for the full design). Create a project at
# supabase.com (free tier is enough), then from Project Settings > API Keys:
#   NEXT_PUBLIC_SUPABASE_URL             — Project URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY — Publishable key (safe to expose to
#                                          the browser; called "anon key" on
#                                          older projects)
#   SUPABASE_SECRET_KEY                  — Secret key (server-only — never
#                                          expose this to the client; called
#                                          "service_role key" on older
#                                          projects; can publish to any
#                                          channel regardless of RLS)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Shared secret for the event-reminders cron endpoint
# (src/app/api/cron/event-reminders/route.ts), called on a schedule by
# netlify/functions/event-reminders.mts. Generate with
# `openssl rand -hex 32`. The endpoint returns 503 until this is set —
# fails closed rather than running unauthenticated.
CRON_SECRET=""

# Stripe — powers paid ad bookings at /advertise (see src/lib/stripe.ts).
# STRIPE_SECRET_KEY: from the Stripe dashboard (test-mode "sk_test_..." keys
# work fine to start). Booking shows "not set up yet" until this is set.
# STRIPE_WEBHOOK_SECRET: create a webhook endpoint in the Stripe dashboard
# pointed at {your domain}/api/webhooks/stripe listening for
# checkout.session.completed, then copy its signing secret here — without
# it, a payment can succeed on Stripe's side but the ad will never move
# past PENDING_PAYMENT since nothing tells this app it was paid.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Phone verification (Twilio Verify) — sends/checks SMS OTPs via Twilio's
# purpose-built Verify product; code generation/expiry/attempt-limiting all
# happen on Twilio's side, nothing is generated or stored here (see
# src/lib/twilio.ts). Create a Verify Service in the Twilio console and copy
# its SID. Twilio also has a free "test credentials" mode — use that in
# local dev to avoid sending real SMS. Inert (requestPhoneVerification
# returns "not_configured") until all three are set.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Video content moderation (Hive's V3 Visual Moderation API) — scans the
# uploaded video file itself, not just its thumbnail frame (see
# src/lib/moderation.ts for the existing caption+thumbnail check, and
# src/lib/hive.ts for this one). Synchronous API, called from the
# moderate-videos cron (not at post-creation time) — a video post still
# publishes immediately, and is retroactively moved to FLAGGED on the next
# cron run if Hive's verdict comes back positive. This is the "Secret Key"
# half of a Service API Key pair generated from the Hive dashboard's
# "Service API Keys" section (labeled "Access Key ID" + "Secret Key" —
# only the Secret Key is used here). Inert until set.
HIVE_API_KEY=""

# Long-video content moderation (Cloudflare Stream + OpenAI) — for post
# videos over Hive's 60s scan limit (src/lib/video-review.ts, run by the
# moderate-long-videos cron). Stream is the safe decode boundary for the
# untrusted uploaded file (thumbnail-at-timestamp images + AI-generated
# captions, both fetched via plain HTTPS — no video processing happens in
# this app's own functions); OpenAI's moderation endpoint then reviews the
# sampled frames and transcript same as everywhere else. Reuses R2_ACCOUNT_ID
# above (Stream and R2 are the same Cloudflare account). API token needs the
# "Stream:Edit" permission — create one under My Profile > API Tokens in the
# Cloudflare dashboard. CLOUDFLARE_STREAM_CUSTOMER_CODE is the
# "customer-<code>.cloudflarestream.com" subdomain shown on the Stream
# dashboard, used to build thumbnail URLs. Long videos stay hidden
# (moderationStatus FLAGGED, reviewable manually from /admin/moderation)
# until all three of these plus OPENAI_API_KEY are set.
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_CUSTOMER_CODE=""

# Cloudflare Stream watermark profile (src/lib/branded-video.ts) — bakes the
# yukon3t brand mark into a video before it's attached to a native "Share via
# device" (the video counterpart of watermark.ts's client-side canvas stamp
# for a still image; images need no separate env var here). One-time setup:
# `node scripts/upload-cloudflare-watermark.mjs` (needs CLOUDFLARE_STREAM_API_TOKEN/
# R2_ACCOUNT_ID above already set to real, valid values) creates the profile
# and prints its uid — paste that here. Reuses the same API token as above
# (it already needs Stream:Edit, which also covers stream/watermarks).
# Sharing a video falls back to the plain unwatermarked file (never
# blocked/broken) until this is set.
CLOUDFLARE_STREAM_WATERMARK_UID=""

# Cloudflare Turnstile bot check (src/lib/turnstile.ts,
# src/components/turnstile-widget.tsx) on sign-up, sign-in (password + magic
# link), forgot-password and ad booking. Create a widget at
# dash.cloudflare.com > Turnstile (Managed mode; add yukon3t.com,
# www.yukon3t.com, yukon3t.vercel.app and yukon3t.netlify.app as hostnames; the
# Capacitor apps load https://yukon3t.com, so they need nothing extra). BOTH must be set —
# it stays fully off (no widget, no CSP change, nothing enforced) until they
# are, and logs an error if only one is. The site key is NEXT_PUBLIC_ so it's
# inlined at BUILD time: set it before deploying, and set both on Vercel and
# Netlify. For local testing use Cloudflare's dummy keys (always passes):
#   site  1x00000000000000000000AA   secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Native-app device attestation (Firebase App Check — src/lib/app-attest.ts,
# src/lib/bot-gate.ts, docs/plans/app-attestation.md). off | observe | enforce;
# unset = off. "observe" records an APP_ATTESTATION analytics row for every
# app submit and still decides on Turnstile only; "enforce" lets a valid,
# single-use token from an allowlisted app replace the Turnstile tap. Read by
# the client too, so it's inlined at BUILD time: set it on Vercel and Netlify,
# then redeploy both. Needs the three FIREBASE_* vars above as well; with any
# of them (or FIREBASE_APP_CHECK_APP_IDS) missing it stays inert and logs an error.
NEXT_PUBLIC_APP_ATTEST_MODE=""
# Comma-separated Firebase App IDs allowed to attest: the Android app's
# mobilesdk_app_id (android/app/google-services.json) and the iOS app's
# GOOGLE_APP_ID (ios/App/App/GoogleService-Info.plist).
FIREBASE_APP_CHECK_APP_IDS=""

# Analytics & search-engine verification (all optional — each is inert on
# its own until set; see src/app/layout.tsx and src/proxy.ts).
#
# Google Tag Manager — create a container at tagmanager.google.com (get a
# GTM-XXXXXXX ID) and manage Google Analytics 4 + any future tags from
# inside it rather than hardcoding gtag.js separately. Inert (no script
# renders, no CSP connect-src opened) until this is set.
NEXT_PUBLIC_GTM_ID=""

# PostHog — session replay + product analytics. Create a project at
# posthog.com (or your own self-hosted instance), copy its API key and
# ingest host (https://us.i.posthog.com for PostHog Cloud US,
# https://eu.i.posthog.com for EU, or your own host if self-hosting — both
# must be set together, or PostHog stays inert, same gating as GTM above).
# Session replay itself also needs "Record user sessions" turned on in the
# project's own Settings > Recordings — the code-side config
# (src/lib/posthog-client.ts) can't reach that toggle.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# Google Search Console ownership verification (HTML tag method) — from
# search.google.com/search-console > Settings > Ownership verification >
# HTML tag, copy just the content="..." value (not the whole <meta> tag).
GOOGLE_SITE_VERIFICATION=""

# Bing Webmaster Tools verification (meta tag method) — from
# bing.com/webmasters > Settings > Ownership verification, copy just the
# content="..." value. Bing can also import an already-verified GSC
# property directly, which skips needing this var at all.
BING_SITE_VERIFICATION=""

# Guest preview, "Explore YuKon3t as a guest" at /try (src/lib/guest-preview.ts): a no-sign-up, read-only visit
# (2 hours max) on one shared guest identity. Off unless exactly "1": /try answers 404 and every live guest session
# ends at its next request. Set on BOTH Vercel and Netlify (shown on /admin/system).
GUEST_PREVIEW_ENABLED=""
# Where the guest banner's "Give feedback" link goes (https:// or mailto:). Unset: mailto:support@yukon3t.com.
NEXT_PUBLIC_FEEDBACK_URL=""
