+
+/// Installs this app's App Check provider factory. Firebase reads the factory
+/// exactly once, when `FirebaseApp.configure()` creates the App Check
+/// component; anything installed later is ignored and the SDK silently uses
+/// its built-in DeviceCheck default. Several plugins call `configure()` from
+/// their `load()`, and Capacitor loads plugins in `Set` order (random per
+/// launch), so this must run before the bridge exists: AppDelegate
+/// instantiates this class by its Objective-C name as the first statement of
+/// `application(_:didFinishLaunchingWithOptions:)`. The ObjC name is fixed
+/// here so that runtime lookup does not depend on Swift name mangling.
+@objc(YKAppCheckProviderInstaller)
+public final class AppCheckProviderInstaller: NSObject {
+    override public init() {
+        super.init()
+        #if DEBUG
+        AppCheck.setAppCheckProviderFactory(AppCheckDebugProviderFactory())
+        #else
+        AppCheck.setAppCheckProviderFactory(CustomAppCheckProviderFactory())
+        #endif
     }
 }
