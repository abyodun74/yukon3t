+/// App Attest only (the package's minimum is iOS 15). Private to this file on
+/// purpose: the messaging plugin carries its own identical copy, so neither
+/// depends on the other's symbols or on load order.
+private final class YKAppAttestProviderFactory: NSObject, AppCheckProviderFactory {
+    func createProvider(with app: FirebaseApp) -> AppCheckProvider? {
+        return AppAttestProvider(app: app)
+    }
+}
+
+/// Firebase reads the App Check provider factory exactly once, when
+/// `FirebaseApp.configure()` eagerly creates the App Check component; a
+/// factory set later is ignored and the SDK uses its DeviceCheck default
+/// (not registered for this app). Every plugin that calls `configure()`
+/// (this one and @capacitor-firebase/messaging, loaded in random order)
+/// therefore calls this immediately before it, inside its
+/// `FirebaseApp.app() == nil` guard, so whichever runs first wins.
+private func ykInstallAppCheckProviderFactory() {
+    #if DEBUG
+    AppCheck.setAppCheckProviderFactory(AppCheckDebugProviderFactory())
+    #else
+    AppCheck.setAppCheckProviderFactory(YKAppAttestProviderFactory())
+    #endif
+}
